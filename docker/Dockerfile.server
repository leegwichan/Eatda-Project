# Stage 1: Build
FROM eclipse-temurin:21-jdk AS builder

WORKDIR /build

# Copy Gradle wrapper and build files first for dependency caching
COPY gradlew settings.gradle build.gradle ./
COPY gradle/ gradle/

# Fix Windows CRLF line endings and set execute permission
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew

# Pre-download dependencies
RUN ./gradlew dependencies --no-daemon

# Copy source code
COPY src/ src/

# Build JAR (skip tests and openapi3 since bootJar depends on openapi3)
RUN ./gradlew bootJar --no-daemon -x test -x openapi3

# Stage 2: Runtime
FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=builder /build/build/libs/eatda-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
