# Kakao OAuth / API (required - get from Kakao Developer Console)
JWT_SECRET_KEY=local-docker-jwt-secret-key-must-be-at-least-32-characters-long
OAUTH_CLIENT_ID=your_kakao_oauth_client_id
KAKAO_API_KEY=your_kakao_rest_api_key

# Next.js session encryption (must be 32+ characters)
SESSION_PASSWORD=change-me-to-a-random-32char-pw!

# Server-to-server origin verification
ORIGIN_VERIFY=local-docker-origin-verify-key
